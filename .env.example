# Ask Christopher — environment variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Optional — defaults live in config/, these override them
# ---------------------------------------------------------------------------

# Model to use. See docs/decisions/ for why this default was chosen.
# ASK_CHRISTOPHER_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
# ASK_CHRISTOPHER_EFFORT=high

# Set to 1 to print token usage and cache statistics after each turn.
# ASK_CHRISTOPHER_DEBUG=0
