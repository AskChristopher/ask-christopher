# Canonical origin: https://christophermathews.com
#
# One site, one origin. Four origins used to answer - apex and www, each over
# http and https - so this collapses them to one with a permanent redirect.
#
# ORDER IS LOAD-BEARING: this block must stay above the /api exclusion below.
# That rule ends in [L], so if it ran first a plaintext request to /api would be
# handed straight to Passenger and answered over cleartext, which is the whole
# thing being fixed here. Sitting above it, http://.../api/health redirects to
# https first and reaches Passenger only on the second, encrypted request.
#
# Both rules name the apex literally rather than rewriting the host, so each of
# the three non-canonical origins arrives in a single hop rather than chaining
# http://www -> https://www -> https://apex.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Not on TLS -> canonical https. Requiring BOTH signals to disagree is
#    deliberate. A single-signal rule redirects an https request to itself
#    forever if %{HTTPS} is ever unavailable on this host; demanding that the
#    port disagree as well means a missing signal declines to redirect instead
#    of looping. Failing open to no-redirect is recoverable; a loop is not.
RewriteCond %{HTTPS} !=on
RewriteCond %{SERVER_PORT} !=443
RewriteRule ^ https://christophermathews.com%{REQUEST_URI} [R=301,L]

# 2. Already on TLS but on www -> canonical apex.
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://christophermathews.com%{REQUEST_URI} [R=301,L]
</IfModule>

# HSTS: once a browser has seen this header over a real TLS connection, it
# stops trying the plaintext origin at all for the given window, closing the
# second half of the 2026-08-30 finding (no HTTPS redirect, no HSTS header) -
# the block above opened only the first half.
#
# env=HTTPS restricts the header to responses Apache actually served over
# TLS, so a client that somehow still reaches this rule over plaintext never
# receives it. That should be unreachable given the redirect above, but the
# header costs nothing extra to scope correctly and this is defence in depth
# rather than reliance on one rule alone.
#
# max-age=86400 (one day) is a first-rollout value, not the target. This is
# the header's first time in production on this host: HTTPS itself already
# works (only the redirect and this header were missing), so the residual
# risk is narrow, but a day-long window is still short enough to recover
# from an unforeseen TLS problem without locking visitors out for weeks.
# Raise it in stages - a week, then months - once it has run clean.
#
# No includeSubDomains: no subdomain of christophermathews.com is confirmed
# to serve HTTPS in this deployment, and this directive cannot be scoped
# per-subdomain, so turning it on would force TLS on hosts nobody has
# verified. No preload: the browser preload list is effectively permanent
# once joined and this header has not run in production at all yet -
# reconsider both after a stable observation period.
<IfModule mod_headers.c>
Header always set Strict-Transport-Security "max-age=86400" env=HTTPS
</IfModule>

# Block the include-only files.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^wp-admin/includes/ - [F,L]
RewriteRule !^wp-includes/ - [S=3]
RewriteRule ^wp-includes/[^/]+\.php$ - [F,L]
RewriteRule ^wp-includes/js/tinymce/langs/.+\.php - [F,L]
RewriteRule ^wp-includes/theme-compat/ - [F,L]
</IfModule>
<Files wp-config.php>
<IfModule !mod_authz_core.c>
order allow,deny
deny from all
</IfModule>
<IfModule mod_authz_core.c>
require all denied
</IfModule>
</Files>

RewriteRule ^api($|/) - [L]

# BEGIN WordPress
# The directives (lines) between "BEGIN WordPress" and "END WordPress" are
# dynamically generated, and should only be modified via WordPress filters.
# Any changes to the directives between these markers will be overwritten.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>

# END WordPress
