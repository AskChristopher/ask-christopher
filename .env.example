# Ask Christopher — environment variables
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Read by src/ask_christopher/env.py at every entry point that talks to the API.
# A variable already set in your shell always wins over the value here, so a
# stale file can never shadow a key you exported deliberately.
#
# A `#` inside a value is part of the value, not a comment. Put comments on
# their own line.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Optional — defaults live in config/, these override them
# ---------------------------------------------------------------------------

# Model to use. See docs/decisions/ for why this default was chosen.
# ASK_CHRISTOPHER_MODEL=claude-opus-5

# Reasoning effort: low | medium | high | xhigh | max
# ASK_CHRISTOPHER_EFFORT=high

# Set to 1 to print token usage and cache statistics after each turn.
# ASK_CHRISTOPHER_DEBUG=0

# ---------------------------------------------------------------------------
# Web deployment (Phase 2) — set these in cPanel's Environment Variables
# panel, not in a file. See docs/decisions/0004-*.md.
# ---------------------------------------------------------------------------

# Daily request ceiling for the public endpoint. REQUIRED by the web app:
# absent or unparseable leaves the gate closed and every request returns 503,
# because an unconfigured gate must not become an ungated endpoint.
#
# Cost anchor: a new visitor's first question is roughly $0.27 on
# claude-opus-5 (a cold cache write on the ~41,800-token prefix); a follow-up
# inside the 5-minute TTL is roughly $0.03. So this value is close to a daily
# dollar ceiling. Ten is the deliberate starting point for the first
# deployment — low enough to be safe while nothing is measured.
ASK_DAILY_LIMIT=10

# Where the usage counter lives. Defaults to usage.sqlite3 beside
# passenger_wsgi.py, which cPanel keeps outside the document root. Only set
# this to move it; never put it anywhere web-served.
# ASK_USAGE_DB=/home/USER/apps/ask-api/usage.sqlite3
